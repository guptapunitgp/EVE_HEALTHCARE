ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://eve_user:eve_local_only@localhost:5433/eve_healthcare
# For Neon, use the direct (non-pooler) URL for schema migrations.
MIGRATION_DATABASE_URL=
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=
FIREBASE_PROJECT_ID=
INITIAL_ADMIN_EMAIL=
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
REDIS_URL=redis://localhost:6379/0
# Optional. When omitted, Celery uses REDIS_URL (recommended for Upstash).
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENABLE_DEV_AUTH=false
